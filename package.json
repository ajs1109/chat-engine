{
  "name": "chat-engine-monorepo",
  "private": true,
  "workspaces": [
    "client",
    "server",
    "web"
  ],
  "scripts": {
    "dev:web": "npm --workspace web run dev",
    "build:web": "npm --workspace web run build",
    "lint:web": "npm --workspace web run lint",
    "start:web": "npm --workspace web run start",
    "start:azure": "SERVE_NEXT=true NODE_ENV=production npm --workspace server run start:prod"
  }
}
